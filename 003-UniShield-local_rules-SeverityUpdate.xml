<group name="sophos-firewall-traffic,">

  <!-- Rule 100130: Denied Traffic - Same IP blocked multiple times -->
  <rule id="100130" level="12" frequency="10" timeframe="120" ignore="60">
    <if_matched_sid>100108,100109,100110,100114,100115,100116</if_matched_sid>
    <same_source_ip />
    <description>SonicWall Firewall: Multiple dropped packets from same source $(srcip) - Possible attack/scan</description>
    <mitre>
      <id>T1046</id>
    </mitre>
  </rule>

  <!-- Rule 100131: Port Scan Detected by Firewall -->
  <rule id="100131" level="12">
    <decoded_as>sophos-firewall</decoded_as>
    <match>m=82</match>
    <description>SonicWall Firewall: Port scan detected - $(srcip)</description>
    <mitre>
      <id>T1046</id>
    </mitre>
  </rule>

  <!-- Rule 100132: Port Scan - Multiple ports from same IP -->
  <rule id="100132" level="12" frequency="15" timeframe="10" ignore="60">
    <if_matched_sid>100108,100109</if_matched_sid>
    <same_source_ip />
    <description>SonicWall Firewall: Possible port scan - $(srcip) hit multiple ports</description>
    <mitre>
      <id>T1046</id>
    </mitre>
  </rule>

</group>
<!-- ============ SOPHOS FIREWALL LOCAL RULES ============ -->
<group name="sophos-firewall">


  <!-- Rule 1: Admin Login Failed -->
  <rule id="900001" level="12">
    <decoded_as>sophos-firewall</decoded_as>
    <match>m=30</match>
    <description>SonicWall Firewall: Admin login failed - $(srcuser) from $(srcip)</description>
  </rule>

  <!-- Rule 2: User Login Failed -->
  <rule id="100002" level="12">
    <decoded_as>sophos-firewall</decoded_as>
    <match>m=33</match>
    <description>SonicWall Firewall: User login failed - $(srcuser) from $(srcip)</description>
  </rule>

  <!-- Rule 3: User Created -->
  <rule id="100003" level="12">
    <decoded_as>sophos-firewall</decoded_as>
    <match>m=1333</match>
    <description>SonicWall Firewall: User $(object) was $(status)</description>
  </rule>

  <!-- Rule 4: User Edited -->
  <rule id="100004" level="12">
    <decoded_as>sophos-firewall</decoded_as>
    <match>m=1334</match>
    <description>SonicWall Firewall: User $(object) was $(status)</description>
  </rule>

  <!-- Rule 5: User Deleted -->
  <rule id="100005" level="12">
    <decoded_as>sophos-firewall</decoded_as>
    <match>m=1335</match>
    <description>SonicWall Firewall: User $(object) was $(status)</description>
  </rule>

  <!-- Rule 6: User Added to Group -->
  <rule id="100006" level="12">
    <decoded_as>sophos-firewall</decoded_as>
    <match>m=14334</match>
    <description>SonicWall Firewall: User group change - $(target_user)</description>
  </rule>

  <!-- Rule 7: Security Policy Modified -->
  <rule id="100007" level="12">
    <decoded_as>sophos-firewall</decoded_as>
    <match>m=441</match>
    <description>SonicWall Firewall: Policy $(object) $(status)</description>
  </rule>

  <!-- Rule 8: Configuration Change Successful -->
  <rule id="100008" level="12">
    <decoded_as>sophos-firewall</decoded_as>
    <match>m=1382</match>
    <description>SonicWall Firewall: Config changed.</description>
  </rule>
</group>
