  <rule id="100121" level="5">
    <decoded_as>sophos-firewall</decoded_as>
    <match>m=98</match>
    <description>SonicWall Firewall: Connection opened - $(srcip) to $(dstip)</description>
  </rule>

  <!-- Rule 100122: Connection Closed (m=537) -->
  <rule id="100122" level="5">
    <decoded_as>sophos-firewall</decoded_as>
    <match>m=537</match>
    <description>SonicWall Firewall: Connection closed - $(srcip) to $(dstip)</description>
  </rule>

  <!-- Rule 100123: NAT Mapping (m=1197) -->
  <rule id="100123" level="5">
    <decoded_as>sophos-firewall</decoded_as>
    <match>m=1197</match>
    <description>SonicWall Firewall: NAT Mapping - $(srcip) to $(dstip)</description>
