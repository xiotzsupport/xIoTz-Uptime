    <decoded_as>sophos-firewall</decoded_as>
    <match>m=59[78]</match>
    <description>SonicWall Firewall: ICMP allowed - $(srcip) to $(dstip)</description>
  </rule>

  <!-- Rule 100126: Packet Allowed (m=1235) -->
  <rule id="100126" level="5">
    <decoded_as>sophos-firewall</decoded_as>
    <match>m=1235</match>
    <description>SonicWall Firewall: Packet allowed - $(srcip) to $(dstip)</description>
  </rule>

  <!-- Rule 100127: DNS Resolve Success (m=1480) -->
  <rule id="100127" level="5">
    <decoded_as>sophos-firewall</decoded_as>
    <match>m=1480</match>
    <description>SonicWall Firewall: DNS resolve - $(note)</description>
  </rule>

  <!-- Rule 100128: Interface Statistics (m=805) -->
  <rule id="100128" level="5">
    <decoded_as>sophos-firewall</decoded_as>
    <match>m=805</match>
    <description>SonicWall Firewall: Interface stats - $(interface)</description>
  </rule>

</group>

