  <!-- Rule 100124: DNS Allowed (m=602) -->
  <rule id="100124" level="5">
    <decoded_as>sophos-firewall</decoded_as>
    <match>m=602</match>
    <description>SonicWall Firewall: DNS allowed - $(srcip) to $(dstip)</description>
