<!--
  - Allowed static fields:
  - location   - where the log came from (only on FTS)
  - srcuser    - extracts the source username
  - dstuser    - extracts the destination (target) username
  - user       - an alias to dstuser (only one of the two can be used)
  - srcip      - source ip
  - dstip      - dst ip
  - srcport    - source port
  - dstport    - destination port
  - protocol   - protocol
  - id         - event id
  - url        - url of the event
  - action     - event action (deny, drop, accept, etc)
  - status     - event status (success, failure, etc)
  - extra_data - Any extra data
-->
<!--
  Custom SonicWall Decoder - Extracts additional fields
  Works with fixed 0295-sonicwall_decoders.xml
-->

<decoder name="sonicwall-extra">
  <parent>sonicwall</parent>
  <regex type="pcre2">\busr="([^"]+)"|\bsess="([^"]+)"|\bn=(\d+)\b|\bnote="([^"]+)"|\bdur=(\d+)\b|\bm=(\d+)\b|\bc=(\d+)\b</regex>
  <order>srcuser, session, event_id, note, duration, msg_id, category</order>
</decoder>

